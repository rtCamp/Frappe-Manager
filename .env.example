# Local development configuration for fm's own tooling.
#
# Copy to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is gitignored and sourced automatically by direnv (see .envrc), so these
# become real environment variables on `cd` into the repo. Nothing here is read by
# the `fm` CLI itself; these drive the repo's own recipes and test harnesses only.
#
# Keep every real host, user, domain and credential in `.env`, NEVER in a tracked
# file: the justfile and scripts read them from the environment precisely so a
# checkout carries no one's infrastructure.

# ── Remote test server ────────────────────────────────────────────────────────
# SSH target for the migration harness (scripts/migrate-test.sh, the `just
# migrate-*` recipes) and its `just migrate-perms` preflight.
export FM_SERVER="frappe@myserver.example.com"

# Home directory of that account on the remote. The harness derives the fm data
# directory ($FM_HOME/frappe) and its transient build venv ($FM_HOME/.fm-tmp)
# from this, so it must be the real home of FM_SERVER's user.
export FM_HOME="/home/frappe"

# Path to uv on the remote; the harness installs both fm versions with it.
export FM_UV="/home/frappe/.local/bin/uv"

# ── README hero image (just readme-hero) ──────────────────────────────────────
# SSH target holding the bench that gets screenshotted. Usually the same box as
# FM_SERVER, kept separate so you can shoot the hero somewhere else.
export FM_REMOTE="frappe@myserver.example.com"

# Bench whose `fm info` card becomes docs/assets/fm-demo.svg. This one is a
# product shot, so give it a presentable name and real apps (e.g. ERPNext), not a
# throwaway. The recipe redacts the passwords `fm info` prints.
export FM_HERO_BENCH="acme"

# fm source checkout on FM_REMOTE; the recipe runs ./.venv/bin/fm from here.
# Optional, defaults to ~/fm-src.
export FM_SRC="~/fm-src"

# ── Migration testing (scripts/migrate-test.sh) ───────────────────────────────
# Bench on the remote that the migration run targets.
export FM_BENCH="mybench.example.com"

# Interpreters for the previous and the target fm. The previous release may need
# an older Python than the one the target pins.
export FM_PREVIOUS_PYTHON="3.12"
export FM_PYTHON="3.13"

# Which fm to migrate FROM and TO. Any pip-installable spec: a git ref, a tag, or
# a PyPI version.
export FM_PREVIOUS_REPO="git+https://github.com/rtcamp/frappe-manager@v0.20.0"
export FM_REPO="git+https://github.com/rtcamp/frappe-manager@develop"

# Flags handed to `fm migrate` on the remote. Every flag must exist on the CURRENT
# CLI or the run dies on an unknown option: the address is positional (BENCH|all),
# unattended is --yes, and the backup skips are --skip-backup /--skip-db-backup /
# --skip-config-backup, with --exclude-bench to leave a bench alone.
export FM_MIGRATE_FLAGS="all --yes --rerun --skip-backup"

# Stop the bench's containers before migrating (the migration does not need it;
# it recreates them either way).
export FM_STOP_CONTAINERS=false
