# Local development configuration for fm's own tooling.
#
#     cp .env.example .env      # then fill in your own values
#
# `.env` is gitignored and sourced automatically by direnv (see .envrc), so these
# become real environment variables on `cd` into the repo. Nothing here is read by
# the `fm` CLI itself; these drive the repo's own recipes and harnesses only.
#
# Keep every real host, user, domain and credential in `.env`, NEVER in a tracked
# file: the justfile and scripts read them from the environment precisely so a
# checkout carries no one's infrastructure.
#
# THREE independent things want a remote box, so every variable is prefixed with
# the one that owns it: FM_MIGRATION_*, FM_SYNC_*, FM_HERO_*. Nothing is shared
# between the groups, and you can point them at three different machines.
#
#   FM_MIGRATION_*   scripts/migrate-test.sh, `just migrate-*`
#                    Upgrade/rollback rehearsal: installs one fm, upgrades to
#                    another, migrates a real bench.  DESTRUCTIVE.
#
#   FM_SYNC_*        `just sync`, `just sync-watch`
#                    Rsyncs this working tree to the target's ~/fm-src.
#                    Writes files, runs nothing.
#
#   FM_HERO_*        `just readme-hero`
#                    Screenshots one bench into docs/assets/fm-demo.svg.
#                    READ-ONLY: runs `fm info` and nothing else.
#
# They may all hold the same host; nothing breaks if they differ.


# ══ Group 1: migration rehearsal ══════════════════════════════════════════════
# Used only by scripts/migrate-test.sh and the `just migrate-*` recipes, which
# install one fm version, then upgrade to another and migrate a real bench on it.
# This WRITES to the target box. Point it at a throwaway server, never production.

# SSH target that hosts the rehearsal. Form: user@host.
export FM_MIGRATION_SSH="frappe@migrate-test.example.com"

# Home directory of that user. The harness derives the fm data directory
# ($FM_MIGRATION_HOME/frappe) and its transient build venv (.fm-tmp) from it, so
# it must be that user's real home.
export FM_MIGRATION_HOME="/home/frappe"
# (FM_MIGRATION_DIR and FM_MIGRATION_TMP are DERIVED from this inside
#  scripts/migrate-test.sh. Do not set them here.)

# Path to uv on FM_MIGRATION_SSH; the harness installs both fm versions with it.
export FM_MIGRATION_UV="/home/frappe/.local/bin/uv"

# Bench on FM_MIGRATION_SSH that gets migrated. Its data is at risk by design.
export FM_MIGRATION_BENCH="mybench.example.com"

# Interpreters for the previous and the target fm. An older release may need an
# older Python than the version the target pins.
export FM_MIGRATION_PREVIOUS_PYTHON="3.12"
export FM_MIGRATION_PYTHON="3.13"

# Which fm to migrate FROM and TO. Any pip-installable spec: git ref, tag, or
# PyPI version.
export FM_MIGRATION_PREVIOUS_REPO="git+https://github.com/rtcamp/frappe-manager@v0.20.0"
export FM_MIGRATION_REPO="git+https://github.com/rtcamp/frappe-manager@develop"

# Flags handed to `fm migrate` on the remote. Every flag must exist on the CURRENT
# CLI or the run dies on an unknown option: the address is positional (BENCH|all),
# unattended is --yes, and the backup skips are --skip-backup / --skip-db-backup /
# --skip-config-backup, with --exclude-bench to leave a bench alone.
export FM_MIGRATION_FLAGS="all --yes --rerun --skip-backup"

# Stop the bench's containers before migrating. The migration does not need it; it
# recreates them either way.
export FM_MIGRATION_STOP_CONTAINERS=false


# ══ Group 2: remote sync ══════════════════════════════════════════════════════
# Used only by `just sync` / `just sync-watch`, which rsync this working tree to
# ~/fm-src on the target. That checkout's direnv venv is an EDITABLE install, so
# synced edits take effect there immediately. Writes files; runs nothing.

# SSH target to push the working tree to. Form: user@host.
export FM_SYNC_SSH="frappe@dev-box.example.com"


# ══ Group 3: README hero image ════════════════════════════════════════════════
# Used only by `just readme-hero`, which ssh's in, runs `fm info` on one bench and
# renders the output to docs/assets/fm-demo.svg. READ-ONLY on the target box.

# SSH target holding the bench to screenshot. Form: user@host.
export FM_HERO_SSH="frappe@demo.example.com"

# Bench whose `fm info` card becomes the image. It is a product shot, so give it a
# presentable name and real apps (e.g. ERPNext), not a throwaway. The recipe
# redacts the two passwords `fm info` prints.
export FM_HERO_BENCH="acme"

# fm source checkout on FM_HERO_SSH; the recipe runs ./.venv/bin/fm from there.
# Optional, defaults to ~/fm-src.
export FM_HERO_SRC="~/fm-src"
