#!/bin/bash
BENCH_DIR="{{ bench_dir }}"
GUNICORN_ARGS="{{ gunicorn_args }}"
{% if trust_forwarded_proto %}
# --behind-proxy: trust X-Forwarded-Proto from this bench's own nginx so the post-login redirect,
# the session cookie's Secure flag, and OAuth's advertised endpoints see https. Resolved here, at
# start time inside this container, rather than baked in at generation time on the host: nginx's
# address on site-network is dynamic, and this is the earliest point it is guaranteed current.
# `nginx-site`, NOT the bare `nginx`: the bare service name also resolves on the shared
# global-frontend-network, where every bench's nginx answers to it, so it round-robins across
# benches -- the site-scoped alias (docker-compose.tmpl) exists only on THIS bench's own network,
# same reasoning as `frappe-site`/`socketio-site` there.
# Never falls back to trusting every peer (gunicorn's wildcard forwarded-ips setting): if resolution
# fails, the flag is simply omitted and gunicorn keeps its default (nothing forwarded is trusted),
# not "trust anyone".
FM_NGINX_IP="$(getent hosts nginx-site 2>/dev/null | awk '{print $1}' | head -1)"
if [[ -n "$FM_NGINX_IP" ]]; then
    GUNICORN_ARGS="$GUNICORN_ARGS --forwarded-allow-ips=$FM_NGINX_IP"
fi
{% endif %}

if [[ "${NEWRELIC_ENABLED:-}" == "true" && -n "${NEWRELIC_LICENSE_KEY:-}" ]]; then
    "$BENCH_DIR/env/bin/python" -c "import newrelic" 2>/dev/null || \
        /usr/local/bin/uv pip install --quiet newrelic --python "$BENCH_DIR/env/bin/python"

    NR_INI="$BENCH_DIR/config/newrelic.ini"
    NR_GUNICORN_CONF="$BENCH_DIR/config/newrelic-gunicorn.conf.py"

    # post_fork is required: gunicorn --preload loads the WSGI app in the master
    # process before forking. The NR agent harvest thread does not survive fork()
    # so each worker must re-register the agent after fork.
    cat > "$NR_GUNICORN_CONF" <<'GUNICONF'
def post_fork(server, worker):
    import newrelic.agent
    newrelic.agent.register_application(timeout=10.0)
GUNICONF

    if [[ ! -f "$NR_INI" ]]; then
        echo "ERROR: New Relic is enabled but $NR_INI is missing. Run 'fm update' to regenerate it." >&2
        exit 1
    fi

    export NEW_RELIC_CONFIG_FILE="$NR_INI"

    exec "$BENCH_DIR/env/bin/newrelic-admin" run-program \
        "$BENCH_DIR/env/bin/gunicorn" $GUNICORN_ARGS \
        -c "$NR_GUNICORN_CONF"
else
    exec "$BENCH_DIR/env/bin/gunicorn" $GUNICORN_ARGS
fi
