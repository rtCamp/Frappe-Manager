# Use Docker's internal DNS resolver for lazy DNS resolution
# This prevents nginx from crashing if admin tools containers aren't running yet
resolver 127.0.0.11 valid=10s ipv6=off;

# Mailpit
location ^~ /mailpit/ {
    auth_basic "Frappe-Manager Admin Tools";
    auth_basic_user_file {{ auth_file }};
    
    # Use variable to defer DNS resolution to request time (not config load time)
    set $mailpit_upstream {{ mailpit_host }}:8025;
    
    chunked_transfer_encoding on;
    proxy_set_header X-NginX-Proxy true;
    proxy_pass http://$mailpit_upstream;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_http_version 1.1;
    proxy_redirect off;
    proxy_buffering off;
}

# Adminer
location ^~ /adminer/ {
    auth_basic "Frappe-Manager Admin Tools";
    auth_basic_user_file {{ auth_file }};
    
    # Use variable to defer DNS resolution to request time (not config load time)
    set $adminer_upstream {{ adminer_host }}:8080;
    
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $host;
    proxy_pass http://$adminer_upstream;
}
