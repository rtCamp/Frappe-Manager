services:
  frappe:
    image: ghcr.io/rtcamp/frappe-manager-frappe:{{ frappe_image_tag }}
    container_name: REPLACE_ME_WITH_CONTAINER_NAME
    environment:
      USERID: REPLACE_ME_WITH_CURRENT_USER
      USERGROUP: REPLACE_ME_WITH_CURRENT_USER_GROUP
      SERVICE_NAME: frappe
    volumes:
      - fm-sockets:/fm-sockets
      - ./workspace:/workspace
    expose:
      - 80
    labels:
        devcontainer.metadata: '[{ "remoteUser": "frappe"}]'
    networks:
      site-network:
        # Bench-nginx upstreams resolve this alias: it exists ONLY on the site
        # network, so DNS can never return another bench's frappe (the bare
        # service name `frappe` also lives on the shared frontend network).
        aliases:
          - frappe-site
      backend-network:
      frontend-network:

  nginx:
    image: ghcr.io/rtcamp/frappe-manager-nginx:{{ nginx_image_tag }}
    container_name: REPLACE_ME_WITH_CONTAINER_NAME
    # nginx resolves BOTH upstreams at config parse and aborts with
    # `[emerg] host not found in upstream` if either name is missing, so a container that wins
    # the startup race dies and -- with dev's `restart: no` -- stays dead. `service_started` is
    # the right condition, not `service_healthy`: the alias is registered when the container
    # starts, and nginx needs the NAME to resolve, not the app to be ready.
    depends_on:
      - frappe
      - socketio
    user: REPLACE_ME_WITH_CURRENT_USER:REPLACE_ME_WITH_CURRENT_USER_GROUP
    environment:
      SITE_MAPPINGS: REPLACE_ME_WITH_SITE_MAPPINGS
      VIRTUAL_HOST: REPLACE_ME_WITH_SITE_NAME
      VIRTUAL_PORT: 80
      HSTS: 'off'
    volumes:
      - ./workspace:/workspace
      - ./configs/nginx/conf:/etc/nginx
      - ./configs/nginx/logs:/var/log/nginx
      - ./configs/nginx/cache:/var/cache/nginx
      - ./configs/nginx/run:/var/run
      - ./configs/nginx/html:/usr/share/nginx/html
    expose:
      - 80
    networks:
      site-network:
        # Same hazard as `frappe-site`/`socketio-site` above: the bare service name `nginx` also
        # resolves on the shared frontend-network, where every bench's nginx carries it, so
        # DNS round-robins across benches. `fm-web-server.sh.tmpl` resolves THIS alias, not the
        # bare name, to trust the one nginx container that actually proxies to this bench's own
        # gunicorn (see ssl_manager/certificate.py's `behind_proxy` docstring).
        aliases:
          - nginx-site
      frontend-network:

  socketio:
    image: ghcr.io/rtcamp/frappe-manager-frappe:{{ frappe_image_tag }}
    container_name: REPLACE_ME_WITH_CONTAINER_NAME
    environment:
      USERID: REPLACE_ME_WITH_CURRENT_USER
      USERGROUP: REPLACE_ME_WITH_CURRENT_USER_GROUP
      SERVICE_NAME: socketio
    expose:
      - 80
    command: launch_supervisor_service.sh
    volumes:
      - fm-sockets:/fm-sockets
      - ./workspace:/workspace
    networks:
      site-network:
        aliases:
          - socketio-site
      frontend-network:

  schedule:
    image: ghcr.io/rtcamp/frappe-manager-frappe:{{ frappe_image_tag }}
    container_name: REPLACE_ME_WITH_CONTAINER_NAME
    environment:
      USERID: REPLACE_ME_WITH_CURRENT_USER
      USERGROUP: REPLACE_ME_WITH_CURRENT_USER_GROUP
      SERVICE_NAME: schedule
    command: launch_supervisor_service.sh
    volumes:
      - fm-sockets:/fm-sockets
      - ./workspace:/workspace
    networks:
      site-network:
      backend-network:
      frontend-network:

  redis-cache:
    image: redis:8-alpine
    container_name: REPLACE_ME_WITH_CONTAINER_NAME
    volumes:
      - redis-cache-data:/data
    expose:
      - 6379
    networks:
      site-network:

  redis-queue:
    image: redis:8-alpine
    container_name: REPLACE_ME_WITH_CONTAINER_NAME
    volumes:
      - redis-queue-data:/data
    expose:
      - 6379
    networks:
      site-network:

volumes:
  fm-sockets:
    name: fm__SITE_NAME_PREFIX__fm-sockets
  redis-queue-data:
    name: fm__SITE_NAME_PREFIX__redis-queue-data
  redis-cache-data:
    name: fm__SITE_NAME_PREFIX__redis-cache-data

networks:
  site-network:
    name: fm__SITE_NAME_PREFIX__site-network
  frontend-network:
    name: fm-frontend-network
    external: true
  backend-network:
    name: fm-backend-network
    external: true
