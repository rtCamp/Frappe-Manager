services:
  mariadb:
    container_name: fm_mariadb
    image: mariadb:11.8
    user: REPLACE_WITH_CURRENT_USER:REPLACE_WITH_CURRENT_USER_GROUP
    restart: always
    command:
    - --character-set-server=utf8mb4
    - --collation-server=utf8mb4_unicode_ci
    - --skip-character-set-client-handshake
    environment:
      MARIADB_AUTO_UPGRADE: 1
      MYSQL_ROOT_PASSWORD_FILE: REPLACE_WITH_DB_ROOT_PASSWORD_SECRET_FILE
      MYSQL_DATABASE: REPLACE_WITH_DB_NAME
      MYSQL_USER: REPLACE_WITH_DB_USER
      MYSQL_PASSWORD_FILE: REPLACE_WITH_DB_PASSWORD_SECRET_FILE
    volumes:
      - mariadb-data:/var/lib/mysql
      - ./mariadb/conf:/etc/mysql
      - ./mariadb/logs:/var/log/mysql
    networks:
        - backend-network
    secrets:
        - db_password
        - db_root_password

  postgres:
    container_name: fm_postgres
    image: postgres:18
    user: REPLACE_WITH_CURRENT_USER:REPLACE_WITH_CURRENT_USER_GROUP
    restart: always
    profiles:
    - disabled
    environment:
      POSTGRES_PASSWORD_FILE: /run/secrets/postgres_root_password
      POSTGRES_DB: postgres
      POSTGRES_INITDB_ARGS: "--encoding=UTF8 --locale=C"
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
        - backend-network
    secrets:
        - postgres_root_password

  nginx-proxy:
    container_name: fm_nginx-proxy
    user: REPLACE_WITH_CURRENT_USER:REPLACE_WITH_CURRENT_USER_GROUP
    image: jwilder/nginx-proxy:1.11
    environment:
      ACME_HTTP_CHALLENGE_LOCATION: false
      LOG_FORMAT_ESCAPE: json
      LOG_FORMAT: '{"time":"$$time_iso8601","request_id":"$$request_id","client":"$$remote_addr","xff":"$$http_x_forwarded_for","host":"$$host","scheme":"$$scheme","method":"$$request_method","path":"$$request_uri","status":$$status,"bytes":$$body_bytes_sent,"request_time":$$request_time,"upstream":"$$upstream_addr","upstream_status":"$$upstream_status","upstream_time":"$$upstream_response_time","referer":"$$http_referer","ua":"$$http_user_agent"}'
    ports:
      - "80:80"
      - "443:443"
    restart: always
    volumes:
      - "./nginx-proxy/certs:/etc/nginx/certs"
      - "./nginx-proxy/dhparam:/etc/nginx/dhparam"
      - "./nginx-proxy/confd:/etc/nginx/conf.d"
      - "./nginx-proxy/htpasswd:/etc/nginx/htpasswd"
      - "./nginx-proxy/vhostd:/etc/nginx/vhost.d"
      - "./nginx-proxy/html:/usr/share/nginx/html"
      - "./nginx-proxy/logs:/var/log/nginx"
      - "./nginx-proxy/run:/var/run"
      - "./nginx-proxy/ssl:/usr/share/nginx/ssl"
      - "./nginx-proxy/cache:/var/cache/nginx"
      - "/var/run/docker.sock:/tmp/docker.sock:ro"
    networks:
      - frontend-network

networks:
  frontend-network:
    name: fm-frontend-network
    ipam:
      config:
      - subnet: '10.1.0.0/16'
  backend-network:
    name: fm-backend-network
    ipam:
      config:
      - subnet: '10.2.0.0/16'

secrets:
   db_password:
     file: REPLACE_ME_WITH_DB_PASSWORD_TXT_PATH
   db_root_password:
     file: REPLACE_ME_WITH_DB_ROOT_PASSWORD_TXT_PATH
   postgres_root_password:
     file: REPLACE_ME_WITH_POSTGRES_ROOT_PASSWORD_TXT_PATH

volumes:
  mariadb-data:
    name: fm-mariadb-data
  postgres-data:
    name: fm-postgres-data
