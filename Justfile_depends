# Dependabot PR Management
# Usage: just depends [subcommand] [args]
#
# All commands accept an optional `repo` parameter (git remote name or owner/repo):
#   just depends                        # auto-detect from git remote or gh
#   just depends rtcamp/Frappe-Manager  # specific repo

# Path to shared helper script (used via {{_common}} interpolation)
_common := "scripts/depends-common.sh"

# ── List all open Dependabot PRs ──────────────────────────────────────────────
depends repo="auto":
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{_common}}"
    repo=$(resolve_repo "{{repo}}")
    printf "\n  %-6s %-40s %-8s %-8s %-8s %-8s\n" "PR" "Dependency" "CI" "Merge" "Change" "Age"
    printf "  %-6s %-40s %-8s %-8s %-8s %-8s\n" "───" "──────────" "──" "────" "──────" "───"
    FMT='.[] | {number: .number, title: .title, ci: (.statusCheckRollup // [] | map(select(.name | startswith("pytest") or startswith("Unit Tests") or startswith("CodeQL"))) | first | .conclusion // "?"), mergeable: .mergeable, created: .createdAt} | "\(.number)\t\(.title)\t\(.ci)\t\(.mergeable)\t\(.created)"'
    gh pr list --author app/dependabot --state open --repo "$repo" --json number,title,headRefName,statusCheckRollup,mergeable,createdAt --jq "$FMT" | while IFS=$'\t' read -r num title ci mergeable created; do
        [ -z "$num" ] && continue
        dep=$(echo "$title" | sed -n 's/^.*bump \(.*\) from [^ ]* to [^ ]*.*/\1/p' | head -1)
        [ -z "$dep" ] && dep="$title"
        [ ${#dep} -gt 38 ] && dep="${dep:0:35}..."
        change="patch"; [[ "$title" =~ [Mm]inor ]] && change="minor"; [[ "$title" =~ [Mm]ajor ]] && change="major"
        [[ "$ci" == "SUCCESS" || "$ci" == "success" ]] && ci_icon="✅" || ci_icon="❌"
        [[ "$mergeable" == "MERGEABLE" ]] && mg_icon="✅" || mg_icon="⚠️"
        created_ts=$(date -j -f "%Y-%m-%dT%H:%M:%S" "${created:0:19}" +%s 2>/dev/null || date -d "${created:0:19}" +%s 2>/dev/null || echo 0)
        if [ "$created_ts" -gt 0 ] 2>/dev/null; then age=$(( ($(date +%s) - created_ts) / 86400 )); else age="?"; fi
        printf "  #%-5s %-40s %-8s %-8s %-8s %-4sd\n" "$num" "$dep" "$ci_icon" "$mg_icon" "$change" "$age"
    done
    echo ""

# ── Detailed status of a specific PR ──────────────────────────────────────────
depends-status pr repo="auto":
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{_common}}"
    repo=$(resolve_repo "{{repo}}")
    echo ""
    gh pr view "{{pr}}" --repo "$repo" --json title,headRefName,baseRefName,mergeable,mergeStateStatus,createdAt,updatedAt --jq '"PR:      #\(.number) \(.title)\nBranch:  \(.headRefName) → \(.baseRefName)\nCreated: \(.createdAt)\nUpdated: \(.updatedAt)\nMerge:   \(.mergeable) (\(.mergeStateStatus))\n"'
    echo "Check Runs:"
    gh pr view "{{pr}}" --repo "$repo" --json statusCheckRollup --jq '(.statusCheckRollup // [])[] | "  \(.name): \(.conclusion)"'
    echo ""
    echo "Reviews:"
    gh pr view "{{pr}}" --repo "$repo" --json reviews --jq 'if (.reviews // [] | length) > 0 then (.reviews[]) | "  \(.author.login): \(.state) (\(.submittedAt))" else "  (none)" end'

# ── Approve a PR ──────────────────────────────────────────────────────────────
depends-approve pr repo="auto":
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{_common}}"
    repo=$(resolve_repo "{{repo}}")
    echo "Approving PR #{{pr}} on $repo..."
    gh pr review "{{pr}}" --approve --repo "$repo" --body "LGTM"
    echo "Done"

# ── Merge a PR (requires CI green + mergeable) ────────────────────────────────
depends-merge pr repo="auto":
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{_common}}"
    repo=$(resolve_repo "{{repo}}")
    mg=$(gh pr view "{{pr}}" --repo "$repo" --json mergeable --jq '.mergeable')
    if [ "$mg" != "MERGEABLE" ]; then echo "❌ Not mergeable: $mg"; exit 1; fi
    ci=$(gh pr view "{{pr}}" --repo "$repo" --json statusCheckRollup --jq '[.statusCheckRollup[]?.conclusion] | unique | join(",")')
    if echo "$ci" | grep -q -i "failure"; then echo "❌ Failing checks: $ci"; exit 1; fi
    echo "Merging PR #{{pr}} on $repo..."
    gh pr merge "{{pr}}" --repo "$repo" --squash --delete-branch
    echo "Done"

# ── Tell @dependabot to recreate/rebase a PR ──────────────────────────────────
depends-recreate pr repo="auto":
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{_common}}"
    repo=$(resolve_repo "{{repo}}")
    gh pr comment "{{pr}}" --repo "$repo" --body "@dependabot recreate"
    echo "Done"

# ── List stale Dependabot PRs (>30 days old) ──────────────────────────────────
depends-cleanup repo="auto":
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{_common}}"
    repo=$(resolve_repo "{{repo}}")
    echo "Stale Dependabot PRs (>30 days):"
    gh pr list --author app/dependabot --state open --repo "$repo" --json number,title,createdAt --jq '.[] | select(((now - (.createdAt | fromdateiso8601)) / 86400) > 30) | "  #\(.number) \(.title) (\(.createdAt[0:10]))"'
